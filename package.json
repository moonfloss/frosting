{
  "name": "@moonfloss/frosting",
  "version": "1.0.2",
  "description": "Generate structured, deterministic color palettes from a small set of inputs. Ramps, semantic tokens, and optional palette variants.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./color-utils": {
      "types": "./dist/color-utils/index.d.ts",
      "import": "./dist/color-utils/index.js",
      "require": "./dist/color-utils/index.cjs"
    },
    "./ui-control": {
      "types": "./dist/ui-control/index.d.ts",
      "import": "./dist/ui-control/index.js",
      "require": "./dist/ui-control/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.js",
      "require": "./dist/tailwind/index.cjs"
    },
    "./chakra": {
      "types": "./dist/chakra/index.d.ts",
      "import": "./dist/chakra/index.js",
      "require": "./dist/chakra/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/api.d.ts",
      "import": "./dist/cli/api.js",
      "require": "./dist/cli/api.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0",
    "tailwindcss": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "build:sourcemap": "SOURCEMAP=1 tsup",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "pack:local": "npm run build && npm pack",
    "prepublishOnly": "npm run test:run && npm run build",
    "cli": "node dist/cli/index.js",
    "demo:ui-control": "cd src/ui-control/demo && npm run dev",
    "demo:tailwind": "cd src/tailwind/demo && npm run dev",
    "demo:chakra": "cd src/chakra/demo && npm run dev"
  },
  "keywords": [
    "color",
    "palette",
    "design-system",
    "oklab",
    "oklch",
    "ramp",
    "semantic-tokens",
    "light-dark"
  ],
  "author": "moonfloss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonfloss/frosting.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.0.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.0.0"
  }
}
