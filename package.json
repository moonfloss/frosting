{
  "name": "frosting",
  "version": "1.0.0",
  "description": "Generate structured, deterministic color palettes from a small set of inputs. Ramps, semantic tokens, and optional palette variants.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui-control": {
      "types": "./dist/ui-control/index.d.ts",
      "import": "./dist/ui-control/index.js",
      "default": "./dist/ui-control/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.js",
      "default": "./dist/tailwind/index.js"
    },
    "./chakra": {
      "types": "./dist/chakra/index.d.ts",
      "import": "./dist/chakra/index.js",
      "default": "./dist/chakra/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build",
    "cli": "node dist/cli/index.js",
    "demo": "cd src/ui-control/demo && npm run dev",
    "demo:tailwind": "cd src/tailwind/demo && npm run dev",
    "demo:chakra": "cd src/chakra/demo && npm run dev"
  },
  "keywords": [
    "color",
    "palette",
    "design-system",
    "oklab",
    "oklch",
    "ramp",
    "semantic-tokens",
    "light-dark"
  ],
  "author": "moonfloss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonfloss/frosting.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.39.2",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.0.0"
  }
}
